{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "VolleyHub",
    "Audience": "VolleyHub",
    "ExpirationMinutes": 15
  },

  "RefreshToken": {
    "ExpirationDays": 30
  },

  "RefreshTokenCookie": {
    "Name": "volleyhub.refreshToken",
    "Secure": true,
    "SameSite": "Lax"
  }
}